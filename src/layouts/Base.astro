---
import fontsEnHref from '../styles/fonts-en.css?url';
import fontsZhHref from '../styles/fonts-zh.css?url';
import '../styles/tokens.css';
import '../styles/global.css';
import type { Lang } from '../lib/types';
import { otherLangUrl } from '../lib/paths';
import { t } from '../i18n';
import { BEACON_TOKEN, SEARCH_CONSOLE_CODE, beaconConfig } from '../lib/analytics';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** The share preview's picture, a path inside the site (e.g. /illustrations/x-960.webp). */
  image?: string;
}

/** The picture a page without its own one shares (decisions/launch-2). */
const DEFAULT_IMAGE = '/illustrations/creation-of-mundus-960.webp';
const { lang, title, description, image = DEFAULT_IMAGE } = Astro.props;
const htmlLang = lang === 'zh-tw' ? 'zh-Hant-TW' : 'en';
// The same page in each language (every page exists in both), for hreflang alternates; x-default is the root, which
// sends the reader to their browser's language.
const path = Astro.url.pathname;
const root = import.meta.env.BASE_URL;
const inSite = (p: string) => root.replace(/\/$/, '') + p;
// Absolute where the site's address is known (the deploy build sets CHRONICLE_SITE); paths otherwise.
const absolute = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = Astro.site ? new URL(path, Astro.site).href : null;
// English pages never load the Chinese fonts.
const fontsHref = lang === 'zh-tw' ? fontsZhHref : fontsEnHref;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={inSite('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={inSite('/apple-touch-icon.png')} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={lang === 'zh-tw' ? '上古卷軸編年史' : 'Elder Scrolls Chronicle'} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={absolute(inSite(image))} />
    <meta property="og:locale" content={lang === 'zh-tw' ? 'zh_TW' : 'en_US'} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="zh-Hant-TW" href={otherLangUrl(path, 'zh-tw')} />
    <link rel="alternate" hreflang="en" href={otherLangUrl(path, 'en')} />
    <link rel="alternate" hreflang="x-default" href={root} />
    {SEARCH_CONSOLE_CODE && <meta name="google-site-verification" content={SEARCH_CONSOLE_CODE} />}
    {/*
      Fonts (fonts-zh.css / fonts-en.css) never block the first paint, and their slices are only requested once the page has loaded,
      so the dozens of small font files never queue ahead of the scripts, styles and map image the page needs first.
      Until then, and without JavaScript, text shows in the fallback fonts (font-display: swap).
    */}
    <link id="site-fonts" rel="stylesheet" href={fontsHref} media="print" />
    <script is:inline>
      addEventListener('load', function () {
        document.getElementById('site-fonts').media = 'all';
      });
    </script>
    <noscript><link rel="stylesheet" href={fontsHref} /></noscript>
  </head>
  <body>
    {/* Past the header and its links, to the page's own content (every page has a <main id="main">). */}
    <a class="skip-link" href="#main">{t(lang, 'skipToMain')}</a>
    <slot />
    {/*
      Pages the reader is about to open (a link held under the pointer or the finger) are fetched ahead, so they open
      at once: this is a static site, so a fetched page is the page. Links the map page opens in place are left out.
    */}
    <script is:inline type="speculationrules" set:html={JSON.stringify({
      prefetch: [{
        where: { and: [{ href_matches: inSite('/*') }, { not: { selector_matches: '.story-related a, .search-results a' } }] },
        eagerness: 'moderate',
      }],
    })} />
    {/* Visit counting (decisions/analytics): last, at low priority and deferred, so it never holds up the page. */}
    {BEACON_TOKEN && (
      <script is:inline defer fetchpriority="low" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={beaconConfig(BEACON_TOKEN)}></script>
    )}
  </body>
</html>
