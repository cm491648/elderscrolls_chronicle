---
import Base from '../../../layouts/Base.astro';
import ChronicleApp from '../../../components/ChronicleApp';
import { LANGS, type Lang } from '../../../lib/types';
import { CHRONICLE_DATA_ID, CHRONICLE_STORY_ID, pagePlaces, provideChronicleData, providePageStory, scriptJson } from '../../../lib/page-data';
import { loadChronicle } from '../../../lib/data';
import { MAP_SOURCE } from '../../../lib/map-source';
import { t } from '../../../i18n';
import { excerpt } from '../../../lib/excerpt';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    const { summaries } = await loadChronicle(lang);
    for (const e of summaries) paths.push({ params: { lang, id: e.id } });
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const id = Astro.params.id!;
const data = await loadChronicle(lang);
const shared = { events: data.summaries, locations: pagePlaces(data.locations, MAP_SOURCE), people: data.personNames };
provideChronicleData(lang, shared);
providePageStory(lang, data.stories[id]);
const event = data.summaries.find((e) => e.id === id)!;
const description = excerpt(data.plainStories[id], 150);
// The event's own plate is its share picture (the 960px copy, small enough for every preview).
const plate = data.stories[id].illustration?.srcset.find((s) => s.width === 960)?.href;
---
<Base lang={lang} title={`${event.title} | ${t(lang, 'siteTitle')}`} description={description} image={plate}>
  <script is:inline type="application/json" id={CHRONICLE_DATA_ID} set:html={scriptJson(shared)} />
  <script is:inline type="application/json" id={CHRONICLE_STORY_ID} set:html={scriptJson(data.stories[id])} />
  <ChronicleApp client:load lang={lang} initialId={id} />
</Base>
