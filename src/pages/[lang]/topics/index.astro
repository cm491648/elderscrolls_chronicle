---
import Section from '../../../layouts/Section.astro';
import TopicCoverList from '../../../components/TopicCoverList.astro';
import { LANGS, type Lang } from '../../../lib/types';
import { loadSections } from '../../../lib/sections-data';
import { t } from '../../../i18n';
import '../../../styles/cover-list.css';
import '../../../styles/topics.css';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
// The covers alone, in both languages (decisions/sections-round2: the bookcase view was dropped).
const { topics } = await loadSections(lang);
---
<Section lang={lang} section="topics" title={`${t(lang, 'navTopics')} | ${t(lang, 'siteTitle')}`} description={t(lang, 'topicsIntro')}>
  <h1>{t(lang, 'navTopics')}</h1>
  <TopicCoverList lang={lang} topics={topics} />
</Section>
